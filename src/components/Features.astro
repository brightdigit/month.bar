---
import FeatureCard from './FeatureCard.astro';

const features = [
  {
    title: 'Two Display Styles',
    description: 'Choose between a visual pie chart showing your month\'s progress or a simple percentage text display for at-a-glance awareness.',
    icon: '📊'
  },
  {
    title: 'Stay on Track, Effortlessly',
    description: 'Never lose sight of where you are in the month. MonthBar lives quietly in your MenuBar, giving you instant visibility without opening calendars or counting days manually.',
    icon: '✨'
  },
  {
    title: 'Customizable Display',
    description: 'Toggle between viewing remaining time (how much is left) or elapsed time (how much has passed) to match your mental model.',
    icon: '⚙️'
  },
  {
    title: 'Privacy-First Design',
    description: 'No network connection, no data collection, no analytics, no tracking. All calculations performed locally on your device.',
    icon: '🔒'
  },
  {
    title: 'Real-time Updates',
    description: 'Your month progress updates automatically every 60 seconds, ensuring you always have current information at a glance.',
    icon: '⏱️'
  },
  {
    title: 'Native macOS',
    description: 'Built with SwiftUI for macOS. Respects system appearance, accent colors, and includes VoiceOver accessibility support.',
    icon: '🍎'
  }
];
---

<section class="py-16 bg-apple-gray-50 dark:bg-apple-gray-900">
  <div class="container">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-apple-gray-900 dark:text-apple-gray-50">
        Simple, Focused Features
      </h2>
      <p class="text-lg text-apple-gray-700 dark:text-apple-gray-300 max-w-2xl mx-auto">
        MonthBar does one thing well: shows you where you are in the current month. No complexity, no distractions, no feature bloat.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <FeatureCard
          title={feature.title}
          description={feature.description}
          icon={feature.icon}
        />
      ))}
    </div>
  </div>
</section>
