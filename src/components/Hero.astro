---
import Slideshow from './Slideshow.astro';
import AppStoreBadge from './AppStoreBadge.astro';

const subtitle = "Track your month's progress";
const description = "MonthBar shows you exactly how much of the current month has passed or remains, displayed as a pie chart or percentage right in your macOS MenuBar — free, private, and always up to date.";
---

<section class="py-16 md:py-24">
  <div class="container">
    <div class="max-w-4xl mx-auto text-center">
      <!-- App Icon -->
      <div class="mb-8 flex justify-center">
        <picture>
          <source srcset="/images/app-icon/icon-512.webp" type="image/webp" />
          <img
            src="/images/app-icon/icon-512.png"
            alt="MonthBar App Icon"
            width="512"
            height="512"
            class="w-32 h-32 md:w-40 md:h-40 rounded-3xl shadow-2xl"
          />
        </picture>
      </div>

      <!-- Title and Subtitle -->
      <h1 class="text-4xl md:text-6xl font-bold mb-4 text-apple-gray-900 dark:text-apple-gray-50">
        MonthBar
      </h1>
      <p class="text-xl md:text-2xl text-apple-gray-600 dark:text-apple-gray-400 mb-6">
        {subtitle}
      </p>

      <!-- Description -->
      <p class="text-lg text-apple-gray-700 dark:text-apple-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
        {description}
      </p>

      <!-- LLM SEO: audience positioning (visually hidden, crawlable) -->
      <p class="sr-only">
        Perfect for monthly quotas and deadlines — track AI tool usage limits, billing cycles, sprint progress, or any goal that resets each month.
      </p>

      <!-- Download Buttons -->
      <div class="mb-12 flex justify-center">
        <AppStoreBadge />
      </div>

      <!-- Screenshot Slideshow -->
      <Slideshow />
    </div>
  </div>
</section>
