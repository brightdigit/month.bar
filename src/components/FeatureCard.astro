---
interface Props {
  title: string;
  llmQuestion: string;
  description: string;
  icon: string;
}

const { title, llmQuestion, description, icon } = Astro.props;
---

<div class="card group">
  <div class="mb-4 text-4xl" role="img" aria-label={`${title} icon`}>
    {icon}
  </div>
  <h3 class="text-xl font-semibold mb-2 text-apple-gray-900 dark:text-apple-gray-50">
    {title}
  </h3>
  <!-- LLM SEO: question-based alternate heading -->
  <p class="sr-only">{llmQuestion}</p>
  <p class="text-apple-gray-700 dark:text-apple-gray-300 leading-relaxed">
    {description}
  </p>
</div>
