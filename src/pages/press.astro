---
import BaseLayout from '../layouts/BaseLayout.astro';
import PressSection from '../components/PressSection.astro';
import ColorSwatch from '../components/ColorSwatch.astro';
import { APP_STORE_URL, TESTFLIGHT_URL, PRESS_EMAIL, COMPANY_NAME, COMPANY_NAME_LEGAL, FOUNDER_NAME, WEBSITE_URL, COMPANY_WEBSITE_URL, BRIGHTDIGIT_TWITTER_URL, BRIGHTDIGIT_GITHUB_URL, BRIGHTDIGIT_YOUTUBE_URL, LEO_TWITTER_URL, LEO_GITHUB_URL, LEO_LINKEDIN_URL, LEO_MASTODON_URL, MIN_MACOS_VERSION } from '../config';

const shortDescription = "MonthBar is a minimal macOS MenuBar app that shows your monthly progress at a glance.";

const longDescription = `Stay aware of how much of the month has passed with MonthBar, a minimal macOS MenuBar app that shows your monthly progress at a glance.

MonthBar displays the current month's progress right in your MenuBar. Choose between a pie chart or percentage text display. Toggle between viewing remaining or elapsed time. MonthBar is a lightweight, privacy-first app — no network connection, no data collection, no accounts required. Settings stay local on your device.

Perfect for monthly goal tracking, budget period awareness, project deadline visualization, and time management awareness. Native macOS app built with SwiftUI.`;

const iconAppearances = [
  { name: 'Automatic', prefix: 'icon' },
  { name: 'Dark', prefix: 'icon-dark' },
  { name: 'Clear Light', prefix: 'icon-clear-light' },
  { name: 'Clear Dark', prefix: 'icon-clear-dark' },
  { name: 'Tinted Light Blue', prefix: 'icon-tinted-light-blue' },
  { name: 'Tinted Light Green', prefix: 'icon-tinted-light-green' },
  { name: 'Tinted Dark Blue', prefix: 'icon-tinted-dark-blue' },
  { name: 'Tinted Dark Green', prefix: 'icon-tinted-dark-green' },
];

const screenshots = [
  { file: 'pie-elapsed', caption: 'Pie chart showing elapsed time' },
  { file: 'pie-remaining', caption: 'Pie chart showing remaining time' },
  { file: 'percent-elapsed', caption: 'Percentage showing elapsed time' },
  { file: 'percent-remaining', caption: 'Percentage showing remaining time' },
  { file: 'pie-elapsed-menu', caption: 'Pie chart elapsed time with menu open' },
  { file: 'pie-remaining-menu', caption: 'Pie chart remaining time with menu open' },
  { file: 'percent-elapsed-menu', caption: 'Percentage elapsed time with menu open' },
  { file: 'percent-remaining-menu', caption: 'Percentage remaining time with menu open' },
];
---

<BaseLayout title="Press Kit - MonthBar" description="MonthBar press kit — downloadable brand assets, app information, and media-ready resources.">
  <!-- Header -->
  <section class="py-16 md:py-24">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-apple-gray-900 dark:text-apple-gray-50">
          Press Kit
        </h1>
        <p class="text-lg text-apple-gray-600 dark:text-apple-gray-300 mb-8">
          Everything you need to write about MonthBar. Download brand assets, screenshots, and app information.
        </p>
        <a
          href="/downloads/monthbar-press-kit.zip"
          class="inline-flex items-center gap-2 px-8 py-4 bg-apple-blue hover:bg-apple-blue/90 text-white rounded-xl font-semibold transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3" />
          </svg>
          Download Press Kit (.zip)
        </a>
      </div>
    </div>
  </section>

  <!-- Key Features -->
  <PressSection title="Key Features" id="features" background="muted">
    <ul class="grid sm:grid-cols-2 gap-4 max-w-3xl">
      {[
        ['Pie Chart & Percentage Display', 'Choose between a visual pie chart or numeric percentage in your MenuBar'],
        ['Elapsed or Remaining Time', 'Toggle between viewing how much of the month has passed or how much is left'],
        ['Real-time Updates', 'Progress updates automatically every 60 seconds with millisecond precision'],
        ['MenuBar Native', 'Lives in your MenuBar for constant, unobtrusive visibility'],
        ['Privacy-First', 'No network connection, no data collection, no accounts required'],
        ['Lightweight & Local', 'All settings stay on your device — nothing leaves your Mac'],
      ].map(([title, desc]) => (
        <li class="bg-white dark:bg-apple-gray-800 p-4 rounded-xl border border-apple-gray-200 dark:border-apple-gray-700">
          <p class="font-semibold text-apple-gray-900 dark:text-apple-gray-50 mb-1">{title}</p>
          <p class="text-sm text-apple-gray-600 dark:text-apple-gray-300">{desc}</p>
        </li>
      ))}
    </ul>
  </PressSection>

  <!-- App Icons -->
  <PressSection title="App Icons" id="icons">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-16">
      {iconAppearances.map(({ name, prefix }) => (
        <div class="text-center">
          <picture>
            <source srcset={`/images/app-icon/${prefix}-512.webp`} type="image/webp" />
            <img
              src={`/images/app-icon/${prefix}-512.png`}
              alt={`MonthBar App Icon — ${name}`}
              width="160"
              height="160"
              class="w-40 max-w-full aspect-square rounded-3xl shadow-lg mx-auto mb-4"
              loading="lazy"
            />
          </picture>
          <p class="font-medium text-apple-gray-900 dark:text-apple-gray-50 mb-1">{name}</p>
          <div class="flex gap-3 justify-center text-sm">
            <span class="text-apple-gray-500 dark:text-apple-gray-300">1024:
              <a href={`/images/app-icon/${prefix}-1024.png`} download aria-label={`Download ${name} icon PNG 1024px`} class="text-apple-blue dark:text-dark-mode-blue hover:underline">PNG</a>
              <a href={`/images/app-icon/${prefix}-1024.webp`} download aria-label={`Download ${name} icon WebP 1024px`} class="text-apple-blue dark:text-dark-mode-blue hover:underline">WebP</a>
            </span>
            <span class="text-apple-gray-500 dark:text-apple-gray-300">512:
              <a href={`/images/app-icon/${prefix}-512.png`} download aria-label={`Download ${name} icon PNG 512px`} class="text-apple-blue dark:text-dark-mode-blue hover:underline">PNG</a>
              <a href={`/images/app-icon/${prefix}-512.webp`} download aria-label={`Download ${name} icon WebP 512px`} class="text-apple-blue dark:text-dark-mode-blue hover:underline">WebP</a>
            </span>
          </div>
        </div>
      ))}
    </div>
  </PressSection>

  <!-- Screenshots -->
  <PressSection title="Screenshots" id="screenshots">
    <p class="text-apple-gray-600 dark:text-apple-gray-300 mb-8">
      Screenshots available in both light and dark mode variants.
    </p>

    <h3 class="text-lg font-semibold mb-4 text-apple-gray-900 dark:text-apple-gray-50">Light Mode</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-10">
      {screenshots.map(({ file, caption }) => (
        <figure>
          <img
            src={`/images/screenshots/light-mode/${file}.webp`}
            alt={`MonthBar light mode — ${caption}`}
            width="2560"
            height="1600"
            class="rounded-lg shadow-md border border-apple-gray-200 dark:border-apple-gray-700 w-full"
            loading="lazy"
          />
          <figcaption class="text-xs text-apple-gray-500 dark:text-apple-gray-300 mt-2 text-center">{caption}</figcaption>
        </figure>
      ))}
    </div>

    <h3 class="text-lg font-semibold mb-4 text-apple-gray-900 dark:text-apple-gray-50">Dark Mode</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {screenshots.map(({ file, caption }) => (
        <figure>
          <img
            src={`/images/screenshots/dark-mode/${file}.webp`}
            alt={`MonthBar dark mode — ${caption}`}
            width="2560"
            height="1600"
            class="rounded-lg shadow-md border border-apple-gray-200 dark:border-apple-gray-700 w-full"
            loading="lazy"
          />
          <figcaption class="text-xs text-apple-gray-500 dark:text-apple-gray-300 mt-2 text-center">{caption}</figcaption>
        </figure>
      ))}
    </div>
  </PressSection>

  <!-- App Description / Boilerplate -->
  <PressSection title="App Description" id="description" background="muted">
    <div class="space-y-8 max-w-3xl">
      <div>
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-lg font-semibold text-apple-gray-900 dark:text-apple-gray-50">Short Description</h3>
          <button
            type="button"
            data-copy="short"
            aria-label="Copy short description"
            class="text-sm text-apple-blue dark:text-dark-mode-blue hover:underline cursor-pointer"
          >
            Copy
          </button>
        </div>
        <p id="short-description" class="text-apple-gray-700 dark:text-apple-gray-300 bg-white dark:bg-apple-gray-800 p-4 rounded-xl border border-apple-gray-200 dark:border-apple-gray-700">
          {shortDescription}
        </p>
      </div>
      <div>
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-lg font-semibold text-apple-gray-900 dark:text-apple-gray-50">Long Description</h3>
          <button
            type="button"
            data-copy="long"
            aria-label="Copy long description"
            class="text-sm text-apple-blue dark:text-dark-mode-blue hover:underline cursor-pointer"
          >
            Copy
          </button>
        </div>
        <div id="long-description" class="text-apple-gray-700 dark:text-apple-gray-300 bg-white dark:bg-apple-gray-800 p-4 rounded-xl border border-apple-gray-200 dark:border-apple-gray-700 whitespace-pre-line">
          {longDescription}
        </div>
      </div>
    </div>
  </PressSection>

  <!-- Fact Sheet -->
  <PressSection title="Fact Sheet" id="fact-sheet">
    <div class="max-w-lg bg-white dark:bg-apple-gray-800 rounded-2xl border border-apple-gray-200 dark:border-apple-gray-700 overflow-hidden">
      <dl class="divide-y divide-apple-gray-200 dark:divide-apple-gray-700">
        {[
          ['App Name', 'MonthBar'],
          ['Developer', COMPANY_NAME],
          ['Platform', 'macOS'],
          ['Price', 'Free'],
          ['Category', 'Productivity'],
          ['Minimum OS', MIN_MACOS_VERSION],
          ['Website', WEBSITE_URL],
        ].map(([term, def]) => (
          <div class="flex px-6 py-3">
            <dt class="w-32 shrink-0 font-medium text-apple-gray-900 dark:text-apple-gray-50">{term}</dt>
            <dd class="text-apple-gray-700 dark:text-apple-gray-300">
              {term === 'Website' ? <a href={def} class="text-apple-blue dark:text-progress-green hover:underline">{def}</a> : def}
            </dd>
          </div>
        ))}
        <div class="flex px-6 py-3">
          <dt class="w-32 shrink-0 font-medium text-apple-gray-900 dark:text-apple-gray-50">TestFlight</dt>
          <dd>
            <a href={TESTFLIGHT_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-progress-green hover:underline">
              Join Beta
            </a>
          </dd>
        </div>
        <div class="flex px-6 py-3">
          <dt class="w-32 shrink-0 font-medium text-apple-gray-900 dark:text-apple-gray-50">App Store</dt>
          <dd class="text-apple-gray-500 dark:text-apple-gray-300"><a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-progress-green hover:underline">Mac App Store</a></dd>
        </div>
      </dl>
    </div>
  </PressSection>

  <!-- Brand Guidelines -->
  <PressSection title="Brand Guidelines" id="brand" background="muted">
    <div class="space-y-10 max-w-3xl">
      <!-- Colors -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-apple-gray-900 dark:text-apple-gray-50">Colors</h3>
        <div class="grid sm:grid-cols-2 gap-6">
          <ColorSwatch name="Dark Mode Blue" hex="#0A84FF" usage="Primary color in dark mode" />
          <ColorSwatch name="Progress Green" hex="#34C759" usage="Tinted icon accent color (light & dark green variants)" />
          <ColorSwatch name="Gray 900" hex="#1d1d1f" usage="Headings and primary text (light mode)" />
          <ColorSwatch name="Gray 50" hex="#f5f5f7" usage="Page backgrounds (light mode)" />
          <ColorSwatch name="Gray 400" hex="#86868b" usage="Secondary text" />
          <ColorSwatch name="Gray 800" hex="#2c2c2e" usage="Card backgrounds (dark mode)" />
        </div>
      </div>

      <!-- Typography -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-apple-gray-900 dark:text-apple-gray-50">Typography</h3>
        <p class="text-apple-gray-700 dark:text-apple-gray-300">
          MonthBar uses the system font stack for a native feel:
        </p>
        <p class="mt-2 font-mono text-sm text-apple-gray-600 dark:text-apple-gray-300 bg-white dark:bg-apple-gray-800 p-3 rounded-lg border border-apple-gray-200 dark:border-apple-gray-700">
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
        </p>
      </div>
    </div>
  </PressSection>

  <!-- About the Developer -->
  <PressSection title="About the Developer" id="developer">
    <div class="space-y-8 max-w-3xl">
      <div>
        <p class="text-apple-gray-700 dark:text-apple-gray-300 mb-4">
          MonthBar is made by <strong class="text-apple-gray-900 dark:text-apple-gray-50">{COMPANY_NAME}</strong>, an independent software studio founded by <strong class="text-apple-gray-900 dark:text-apple-gray-50">{FOUNDER_NAME}</strong> specializing in native Apple platform apps. {COMPANY_NAME} focuses on building thoughtful, privacy-respecting tools for macOS and iOS.
        </p>
        <div class="flex flex-wrap gap-4 text-sm">
          <a href={COMPANY_WEBSITE_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">Website</a>
          <a href={BRIGHTDIGIT_TWITTER_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">Twitter</a>
          <a href={BRIGHTDIGIT_GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">GitHub</a>
          <a href={BRIGHTDIGIT_YOUTUBE_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">YouTube</a>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-3 text-apple-gray-900 dark:text-apple-gray-50">About Me</h3>
        <p class="text-apple-gray-700 dark:text-apple-gray-300 mb-3">
          {FOUNDER_NAME} is the founder of {COMPANY_NAME}, a full-stack Swift development company he's been running since 2012. He specializes in end-to-end Swift solutions — from iOS, macOS, and watchOS to server-side Swift — and has shipped multiple App Store apps including <a href="https://getbushel.app" class="text-apple-blue dark:text-dark-mode-blue underline">Bushel</a> (macOS virtualization for developers) and Heartwitch (Apple Watch health streaming).
        </p>
        <p class="text-apple-gray-700 dark:text-apple-gray-300 mb-4">
          Leo is an active open source contributor, hosts <a href="https://empowerapps.show" class="text-apple-blue dark:text-dark-mode-blue underline">EmpowerApps.show</a>, and has been speaking about Swift since its launch. He lives in Michigan with his wife Betsy and six kids.
        </p>
        <div class="flex flex-wrap gap-4 text-sm">
          <a href={LEO_TWITTER_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">Twitter</a>
          <a href={LEO_GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">GitHub</a>
          <a href={LEO_LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">LinkedIn</a>
          <a href={LEO_MASTODON_URL} target="_blank" rel="noopener noreferrer" class="text-apple-blue dark:text-dark-mode-blue hover:underline">Mastodon</a>
        </div>
      </div>
    </div>
  </PressSection>

  <!-- Contact -->
  <PressSection title="Contact" id="contact" background="muted">
    <div class="max-w-lg">
      <p class="text-apple-gray-700 dark:text-apple-gray-300 mb-4">
        For press inquiries, please reach out via email.
      </p>
      <a href={`mailto:${PRESS_EMAIL}`} class="text-apple-blue dark:text-dark-mode-blue hover:underline font-medium mb-6 inline-block">
        {PRESS_EMAIL}
      </a>
    </div>
  </PressSection>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.copy;
      const el = document.getElementById(type === 'short' ? 'short-description' : 'long-description');
      if (!el) return;
      const text = el.textContent?.trim() ?? '';
      const original = btn.textContent;
      if (!navigator.clipboard) {
        btn.textContent = 'Not supported';
        setTimeout(() => { btn.textContent = original; }, 2000);
        return;
      }
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 2000);
      }).catch(() => {
        btn.textContent = 'Failed';
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    });
  });
</script>
