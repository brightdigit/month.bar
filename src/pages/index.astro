---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
---

<BaseLayout>
  <Hero />
  <Features />

  <!-- Call to Action -->
  <section class="py-16">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-apple-gray-900 dark:text-apple-gray-50">
          How do I get MonthBar?
        </h2>
        <p class="text-lg text-apple-gray-700 dark:text-apple-gray-300 mb-4">
          MonthBar is a free macOS MenuBar app — no subscriptions, no in-app purchases, no account required.
        </p>
        <p class="text-lg text-apple-gray-700 dark:text-apple-gray-300 mb-8">
          Join the TestFlight beta to start tracking your month's progress today, or visit our support page for setup help and FAQs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="https://testflight.apple.com/join/N8n1fSPE"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 bg-apple-blue hover:bg-apple-blue/90 text-white rounded-xl font-semibold transition-colors"
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
            </svg>
            Join TestFlight Beta
          </a>
          <a
            href="/support"
            class="inline-flex items-center gap-2 px-8 py-4 bg-apple-gray-100 dark:bg-apple-gray-800 text-apple-gray-900 dark:text-apple-gray-100 hover:bg-apple-gray-200 dark:hover:bg-apple-gray-700 rounded-xl font-semibold transition-colors"
          >
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Built With / Technology -->
  <section class="py-16 bg-apple-gray-50 dark:bg-apple-gray-900">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-8 text-center text-apple-gray-900 dark:text-apple-gray-50">
          How is MonthBar built?
        </h2>
        <div class="prose prose-lg mx-auto text-apple-gray-700 dark:text-apple-gray-300">
          <p>
            MonthBar is a native macOS application built with Apple's <a href="https://developer.apple.com/xcode/swiftui/" target="_blank" rel="noopener noreferrer" class="text-apple-blue hover:underline">SwiftUI framework</a>, following the <a href="https://developer.apple.com/design/human-interface-guidelines/" target="_blank" rel="noopener noreferrer" class="text-apple-blue hover:underline">Apple Human Interface Guidelines</a> for a consistent Mac experience.
          </p>
          <p>
            The app uses the <a href="https://developer.apple.com/documentation/appkit/nsstatusbar" target="_blank" rel="noopener noreferrer" class="text-apple-blue hover:underline">macOS MenuBar API (NSStatusBar)</a> to display progress directly in your MenuBar. All data stays on your device using <a href="https://developer.apple.com/documentation/foundation/userdefaults" target="_blank" rel="noopener noreferrer" class="text-apple-blue hover:underline">macOS UserDefaults</a> — no servers, no cloud sync, no accounts.
          </p>
          <p>
            MonthBar follows <a href="https://developer.apple.com/documentation/accessibility" target="_blank" rel="noopener noreferrer" class="text-apple-blue hover:underline">Apple's Accessibility guidelines</a> with full VoiceOver support and respects system appearance settings including Dark Mode and accent colors.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- References -->
  <section class="py-12 border-t border-apple-gray-200 dark:border-apple-gray-800">
    <div class="container">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-xl font-semibold mb-6 text-apple-gray-900 dark:text-apple-gray-50">
          References & Resources
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-apple-gray-600 dark:text-apple-gray-400">
          <li>
            <a href="https://developer.apple.com/xcode/swiftui/" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">Apple SwiftUI Documentation</a>
          </li>
          <li>
            <a href="https://developer.apple.com/design/human-interface-guidelines/" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">Apple Human Interface Guidelines</a>
          </li>
          <li>
            <a href="https://developer.apple.com/documentation/appkit/nsstatusbar" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">macOS MenuBar API (NSStatusBar)</a>
          </li>
          <li>
            <a href="https://developer.apple.com/documentation/foundation/userdefaults" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">macOS UserDefaults Documentation</a>
          </li>
          <li>
            <a href="https://developer.apple.com/documentation/accessibility" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">Apple Accessibility Framework</a>
          </li>
          <li>
            <a href="https://developer.apple.com/app-store/review/guidelines/" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">App Store Review Guidelines</a>
          </li>
          <li>
            <a href="https://developer.apple.com/privacy/" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">Apple Privacy Overview</a>
          </li>
          <li>
            <a href="https://testflight.apple.com/join/N8n1fSPE" target="_blank" rel="noopener noreferrer" class="hover:text-apple-blue transition-colors">MonthBar TestFlight Beta</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
