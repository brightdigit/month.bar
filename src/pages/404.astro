---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found - MonthBar">
  <div class="container py-24">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-6xl md:text-8xl font-bold mb-4 text-apple-gray-900 dark:text-apple-gray-50">
        404
      </h1>
      <h2 class="text-2xl md:text-3xl font-semibold mb-4 text-apple-gray-700 dark:text-apple-gray-300">
        Page Not Found
      </h2>
      <p class="text-lg text-apple-gray-600 dark:text-apple-gray-400 mb-8">
        Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.
      </p>
      <a href="/" class="btn btn-primary">
        Return Home
      </a>
    </div>
  </div>
</BaseLayout>
