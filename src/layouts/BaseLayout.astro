---
import '../styles/global.css';
import LaunchBanner from '../components/LaunchBanner.astro';
import { APP_STORE_URL, TESTFLIGHT_URL, WEBSITE_URL, COMPANY_NAME, COMPANY_NAME_LEGAL, COMPANY_WEBSITE_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'MonthBar - Track your month\'s progress',
  description = 'MonthBar shows you exactly how much of the current month has passed or remains, displayed as a pie chart or percentage right in your macOS MenuBar — free, private, and always up to date.',
  image = '/images/app-icon/og-image.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "MonthBar",
  "applicationCategory": "ProductivityApplication",
  "operatingSystem": "macOS 14.0 or later",
  "url": WEBSITE_URL,
  "downloadUrl": APP_STORE_URL,
  "softwareVersion": "1.0.0",
  "datePublished": "2026-02-10",
  "dateModified": new Date().toISOString().split('T')[0],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "MonthBar shows you exactly how much of the current month has passed or remains, displayed as a pie chart or percentage right in your macOS MenuBar — free, private, and always up to date.",
  "author": {
    "@type": "Organization",
    "name": COMPANY_NAME_LEGAL,
    "url": COMPANY_WEBSITE_URL
  },
  "featureList": [
    "Pie chart or percentage text display",
    "Toggle remaining or elapsed time",
    "Real-time updates every 60 seconds",
    "Completely offline — no network, no tracking",
    "Native macOS SwiftUI with VoiceOver support",
    "Free with no in-app purchases"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' https: data:; font-src 'self'; connect-src 'self' https://plausible.io; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self';" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/app-icon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/app-icon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/app-icon/apple-touch-icon.png" />

    <!-- Plausible Analytics -->
    <script defer data-domain="month.bar" src="https://plausible.io/js/script.outbound-links.js"></script>

    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="month,progress,tracker,menubar,calendar,time,productivity,widget,days,goals,deadline,simple" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)}></script>
  </head>
  <body>
    <div class="min-h-screen flex flex-col">
      <LaunchBanner />
      <header class="border-b border-apple-gray-200 dark:border-apple-gray-800">
        <nav class="container py-4">
          <div class="flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
              <picture>
                <source srcset="/images/app-icon/icon-512.webp" type="image/webp" />
                <img
                  src="/images/app-icon/icon-512.png"
                  alt="MonthBar Icon"
                  width="32"
                  height="32"
                  class="w-8 h-8 rounded-lg"
                />
              </picture>
              <span class="text-xl font-semibold text-apple-gray-900 dark:text-apple-gray-50">MonthBar</span>
            </a>
            <div class="hidden sm:flex items-center gap-6">
              <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="text-apple-gray-700 dark:text-apple-gray-300 hover:text-apple-blue transition-colors">Download</a>
              <a href="/press" class="text-apple-gray-700 dark:text-apple-gray-300 hover:text-apple-blue transition-colors">Press</a>
              <a href="/support" class="text-apple-gray-700 dark:text-apple-gray-300 hover:text-apple-blue transition-colors">Support</a>
              <a href="/terms" class="text-apple-gray-700 dark:text-apple-gray-300 hover:text-apple-blue transition-colors">Terms</a>
              <a href="/privacy" class="text-apple-gray-700 dark:text-apple-gray-300 hover:text-apple-blue transition-colors">Privacy</a>
            </div>
          </div>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-apple-gray-200 dark:border-apple-gray-800 mt-16">
        <div class="container py-8">
          <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-sm text-apple-gray-600 dark:text-apple-gray-300">
              © 2026 {COMPANY_NAME}. All rights reserved.
            </div>
            <div class="flex items-center gap-6 text-sm">
              <a
                href={APP_STORE_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="text-apple-gray-600 dark:text-apple-gray-300 hover:text-apple-blue transition-colors"
              >
                Mac App Store
              </a>
              <a
                href="/press"
                class="text-apple-gray-600 dark:text-apple-gray-300 hover:text-apple-blue transition-colors"
              >
                Press Kit
              </a>
              <a
                href="/support"
                class="text-apple-gray-600 dark:text-apple-gray-300 hover:text-apple-blue transition-colors"
              >
                Support
              </a>
              <a
                href="/terms"
                class="text-apple-gray-600 dark:text-apple-gray-300 hover:text-apple-blue transition-colors"
              >
                Terms of Use
              </a>
              <a
                href="/privacy"
                class="text-apple-gray-600 dark:text-apple-gray-300 hover:text-apple-blue transition-colors"
              >
                Privacy Policy
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
